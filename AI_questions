window.AI_QUESTIONS = [
{n:1,t:"AI & Agents",q:"Which of the following best defines Artificial Intelligence?",o:["Designing faster hardware components and circuits","Building machines that perform tasks requiring human intelligence","Storing and querying large relational databases","Automating high-speed mechanical manufacturing assembly"],a:1,e:"Artificial Intelligence is the branch of computer science focused on creating systems capable of performing tasks that typically require human cognitive functions, such as learning, reasoning, problem-solving, and natural language understanding."},
{n:2,t:"AI & Agents",q:"What is the primary objective of the Turing Test proposed by Alan Turing in 1950?",o:["To test the maximum processing speed of a quantum computer","To evaluate if a machine can exhibit human-equivalent intelligent behavior in natural language conversation","To measure the accuracy of image classification algorithms","To prove whether mathematical theorems can be automatically generated"],a:1,e:"The Turing Test evaluates whether a human evaluator, engaged in a text-based conversation with a human and a machine, can reliably distinguish the machine from the human."},
{n:4,t:"AI & Agents",q:"Which environment type is characterized by an agent having incomplete or noisy sensor data about the current state?",o:["Fully Observable Environment","Partially Observable Environment","Deterministic Environment","Static Environment"],a:1,e:"In a partially observable environment, the agent's sensors cannot detect the complete state of the environment due to noise, limited sensor range, or unobservable variables (e.g., driving in fog or playing poker)."},
{n:5,t:"AI & Agents",q:"A standard chess game environment is best classified as:",o:["Partially Observable, Stochastic, Dynamic, Continuous, Single-agent","Fully Observable, Deterministic, Static, Discrete, Multi-agent","Fully Observable, Stochastic, Dynamic, Discrete, Single-agent","Partially Observable, Deterministic, Static, Continuous, Multi-agent"],a:1,e:"Chess is fully observable (both players see the board), deterministic (no chance elements), static (board doesn't change while deciding), discrete (finite set of board states/moves), and multi-agent (two competing players)."},
{n:7,t:"AI & Agents",q:"Which agent architecture maintains an internal state to track unobserved aspects of the current world state?",o:["Simple Reflex Agent","Model-based Reflex Agent","Goal-based Agent","Simple Utility Agent"],a:1,e:"Model-based reflex agents handle partial observability by maintaining an internal state that depends on the percept history and an internal model of how the world evolves."},
{n:8,t:"AI & Agents",q:"Which agent architecture uses a real-valued performance function to measure how desirable a given state is?",o:["Simple Reflex Agent","Goal-based Agent","Utility-based Agent","Learning Agent"],a:2,e:"A utility-based agent maps state sequences to real numbers (utility values), allowing it to make trade-offs between competing goals or evaluate success under uncertainty."},
{n:10,t:"Logic & Search",q:"A Semantic Network represents knowledge primarily using:",o:["Tabular relational rows and primary keys","Graphical nodes (entities/concepts) and directed labeled edges (relationships)","Sequential execution blocks","Floating-point mathematical vectors"],a:1,e:"Semantic networks represent semantic relations between concepts in a network structure, using nodes for objects/concepts and labeled directed arcs for relations (e.g., 'is-a', 'has-a')."},
{n:11,t:"Logic & Search",q:"The logical implication P → Q is false if and only if:",o:["P is false and Q is false","P is false and Q is true","P is true and Q is false","P is true and Q is true"],a:2,e:"In propositional logic, material implication P → Q is logically equivalent to ¬P ∨ Q, which evaluates to false only when the premise P is True and the conclusion Q is False."},
{n:13,t:"Logic & Search",q:"Which search algorithm expands nodes using a First-In, First-Out (FIFO) queue data structure?",o:["Breadth-First Search (BFS)","Depth-First Search (DFS)","Depth-Limited Search (DLS)","Uniform Cost Search (UCS)"],a:0,e:"BFS explores nodes level-by-level using a FIFO queue, ensuring that all nodes at depth d are expanded before any nodes at depth d+1."},
{n:14,t:"Logic & Search",q:"Under what condition is Breadth-First Search (BFS) guaranteed to be optimal?",o:["When the search graph contains negative edge cycles","When all step costs are equal (uniform step cost)","When heuristic values are strictly positive","When the branching factor is infinite"],a:1,e:"BFS finds the solution at the shallowest depth. If all actions have identical step costs (e.g., cost = 1), the shallowest goal node is guaranteed to be the lowest-cost optimal solution."},
{n:15,t:"Logic & Search",q:"What is the primary memory space complexity advantage of Depth-First Search (DFS) over BFS?",o:["DFS has space complexity O(b^d) while BFS has space complexity O(b*m)","DFS has space complexity O(b*m) while BFS has space complexity O(b^d)","DFS requires zero memory during execution","DFS space complexity is independent of maximum depth"],a:1,e:"DFS needs to store only a single path from root to leaf along with unexpanded sibling nodes, requiring linear space O(b*m). BFS must store all generated nodes in memory, requiring exponential space O(b^d)."},
{n:17,t:"Logic & Search",q:"Uniform Cost Search (UCS) expands nodes strictly according to:",o:["Highest heuristic estimate h(n)","Shallowest depth level d(n)","Lowest cumulative path cost g(n) from start node","Order of node creation timestamp"],a:2,e:"UCS (equivalent to Dijkstra's algorithm for search trees) uses a priority queue ordered by g(n), guaranteeing optimality for arbitrary non-negative step costs."},
{n:19,t:"Logic & Search",q:"In First-Order Predicate Logic, the expression ¬(∀x P(x)) is logically equivalent to:",o:["∀x ¬P(x)","∃x ¬P(x)","¬(∃x P(x))","∃x P(x)"],a:1,e:"By De Morgan's laws for quantifiers, negating 'For all x, P(x) is true' is equivalent to stating 'There exists at least one x for which P(x) is false'."},
{n:21,t:"Heuristic Search & CSP",q:"A heuristic function h(n) is defined as admissible if it satisfies which of the following conditions?",o:["h(n) >= h*(n) for all nodes n","0 <= h(n) <= h*(n) for all nodes n, where h*(n) is true cost to goal","h(n) = g(n) + h*(n) for all nodes n","h(n) is always an integer greater than zero"],a:1,e:"An admissible heuristic never overestimates the cost to reach the goal. Admissibility guarantees that A* tree search returns an optimal solution."},
{n:22,t:"Heuristic Search & CSP",q:"The evaluation function f(n) in A* Search is expressed as:",o:["f(n) = g(n) - h(n)","f(n) = h(n)","f(n) = g(n)","f(n) = g(n) + h(n)"],a:3,e:"In A*, g(n) is the exact cost incurred from the start node to node n, and h(n) is the estimated cost from node n to the goal. f(n) estimates total path cost through n."},
{n:24,t:"Heuristic Search & CSP",q:"For the 8-puzzle game, why is the Manhattan Distance heuristic strictly superior to (dominates) the Misplaced Tiles heuristic?",o:["Manhattan distance is easier to compute","For every state n, Manhattan distance h_M(n) >= Misplaced tiles h_P(n), giving tighter bounds without overestimating","Misplaced tiles heuristic is inadmissible","Manhattan distance uses diagonal path movements"],a:1,e:"Since h_M(n) >= h_P(n) for all n, A* using h_M will expand fewer or equal total nodes compared to h_P while maintaining admissibility."},
{n:25,t:"Heuristic Search & CSP",q:"Greedy Best-First Search selects the next node to expand based solely on:",o:["Minimum h(n)","Minimum g(n)","Minimum f(n) = g(n) + h(n)","Maximum depth d(n)"],a:0,e:"Greedy Best-First Search expands the node that appears closest to the goal according to h(n). It is fast but neither complete nor optimal."},
{n:27,t:"Heuristic Search & CSP",q:"Which constraint propagation algorithm enforces that for every value in variable Xi's domain, there exists a valid matching value in Xj's domain?",o:["Minimax Pruning","Arc Consistency (AC-3)","Depth-Limited Search","Alpha-Beta Cutoff"],a:1,e:"An arc (Xi, Xj) is consistent if for every x in Di there is some y in Dj satisfying the constraint. AC-3 systematically prunes inconsistent domain values across the graph."},
{n:28,t:"Heuristic Search & CSP",q:"In CSP Backtracking Search, the Minimum Remaining Values (MRV) heuristic selects:",o:["The variable with the fewest legal values left in its domain","The variable involved in the largest number of constraints","The value that rules out the fewest choices for neighboring variables","A random unassigned variable"],a:0,e:"MRV (also known as the 'most constrained variable' or 'fail-first' heuristic) picks the variable most likely to fail soon, pruning bad search branches early."},
{n:30,t:"Heuristic Search & CSP",q:"Given a 3-map coloring problem with RGB colors, what is the domain size for each variable?",o:["1","2","3","6"],a:2,e:"The domain D for each territory variable contains 3 candidate colors: {Red, Green, Blue}."},
{n:31,t:"Adversarial Search",q:"In a zero-sum two-player game, what does 'zero-sum' signify?",o:["Total utility summed across both players is zero for every outcome","Neither player wins any points","Both players receive equal positive rewards","The heuristic evaluation function always returns zero"],a:0,e:"In zero-sum games (e.g., Chess, Checkers, Tic-Tac-Toe), a gain for MAX represents an equal magnitude loss for MIN (Utility_MAX + Utility_MIN = 0)."},
{n:33,t:"Adversarial Search",q:"In Alpha-Beta pruning, the parameter Alpha (α) represents:",o:["The lower bound: best (highest) value MAX is guaranteed so far along the path","The upper bound: best (lowest) value MIN is guaranteed so far","The depth limit of the search tree","The maximum branching factor"],a:0,e:"Alpha tracks MAX's best option. If a MIN node produces a value less than or equal to Alpha, MAX will never choose that path, allowing remaining children to be pruned."},
{n:34,t:"Adversarial Search",q:"In Alpha-Beta pruning, under what mathematical condition is a search branch pruned?",o:["α < β","α >= β","α = 0","β = ∞"],a:1,e:"Pruning occurs whenever α >= β. This condition indicates that the current node's parent player already has a strictly better guaranteed alternative elsewhere."},
{n:35,t:"Adversarial Search",q:"What is the theoretical time complexity of Alpha-Beta pruning under PERFECT move ordering?",o:["O(b^m)","O(b^(m/2))","O(b * m)","O(m^b)"],a:1,e:"With optimal move ordering (best moves evaluated first), Alpha-Beta doubles the effective search depth solvable in the same time frame as standard Minimax."},
{n:37,t:"Adversarial Search",q:"What is the horizon effect in game-playing AI search?",o:["Memory running out due to deep recursions","An inevitable bad event pushed beyond the search depth limit by delaying tactics","Reaching the root node of a game tree","Overestimating winning probabilities"],a:1,e:"The horizon effect occurs when search depth limits prevent the agent from seeing a damage state that is guaranteed to happen right after the horizon."},
{n:39,t:"NLP",q:"The process of breaking a raw body of text into individual words, phrases, or symbols is called:",o:["Vectorization","Tokenization","Lemmatization","Sentiment Analysis"],a:1,e:"Tokenization is the foundational NLP preprocessing step that converts unstructured text strings into discrete tokens (words, subwords, or punctuation)."},
{n:41,t:"NLP",q:"Common grammatical words such as 'is', 'the', 'and', 'at' that carry minimal semantic value and are frequently removed during preprocessing are called:",o:["Keywords","N-grams","Stop Words","Hypernyms"],a:2,e:"Removing stop words reduces dimensionality and focuses document models on content-bearing vocabulary."},
{n:42,t:"NLP",q:"What does TF-IDF stand for in text feature extraction?",o:["Total Frequency - Inverse Data Format","Term Frequency - Inverse Document Frequency","Text Feature - Integrated Document Factor","Term Formula - Iterative Distance Function"],a:1,e:"TF-IDF measures word importance: TF counts frequency in a document, while IDF penalizes words that appear commonly across all corpus documents."},
{n:44,t:"NLP",q:"Which N-gram model processes continuous sequences of two adjacent tokens?",o:["Unigram","Bigram","Trigram","Skip-gram"],a:1,e:"An N-gram of size 2 is a bigram (e.g., 'Artificial Intelligence'). Size 1 is unigram, size 3 is trigram."},
{n:45,t:"NLP",q:"Word2Vec models (CBOW and Skip-gram) construct word embeddings by mapping words into:",o:["High-dimensional sparse binary matrices","Low-dimensional dense continuous vector space reflecting semantic similarities","Alphabetical index lists","Decision tree nodes"],a:1,e:"Word2Vec represents semantic similarity geometrically (e.g., Vector('King') - Vector('Man') + Vector('Woman') approx Vector('Queen'))."},
{n:47,t:"NLP",q:"Which landmark architecture introduced the Self-Attention mechanism in 2017 ('Attention Is All You Need')?",o:["Recurrent Neural Network (RNN)","Convolutional Neural Network (CNN)","Transformer","Multilayer Perceptron (MLP)"],a:2,e:"Transformers process tokens in parallel via self-attention, replacing sequential RNN bottlenecks and powering models like BERT and GPT."},
{n:48,t:"NLP",q:"Part-of-Speech (POS) tagging categorizes tokens into grammatical classes such as:",o:["Noun, Verb, Adjective, Adverb","Positive, Negative, Neutral","Entity, Relation, Attribute","Input, Hidden, Output"],a:0,e:"POS taggers annotate words with syntactic roles based on context and definitions."},
{n:50,t:"NLP",q:"In Cosine Similarity between two word vectors A and B, a value of 1.0 indicates:",o:["Vectors point in identical directions (maximum similarity)","Vectors are orthogonal (no similarity)","Vectors point in opposite directions","Vectors have zero magnitude"],a:0,e:"Cosine similarity cos(theta) = (A . B) / (||A||*||B||). 1.0 means identical orientation (angle 0 deg)."},
{n:51,t:"Supervised Learning",q:"Supervised Learning differs fundamentally from Unsupervised Learning because Supervised Learning requires:",o:["Unlabeled raw feature clusters","Ground-truth target output labels (Y)","Real-time reward signals","Zero training dataset"],a:1,e:"Supervised learning algorithms learn a mapping function f(X) -> Y using paired training data (X_train, Y_train)."},
{n:52,t:"Supervised Learning",q:"Which of the following problems is a Regression task?",o:["Classifying an email as Spam or Ham","Predicting continuous house sales prices in dollars","Identifying handwritten digits (0 to 9)","Grouping customer shopping profiles"],a:1,e:"Regression models predict continuous numerical values, whereas classification models predict discrete categorical class labels."},
{n:54,t:"Supervised Learning",q:"In Gradient Descent optimization, if the learning rate alpha (α) is set excessively large:",o:["Convergence occurs instantly in 1 step","The algorithm may overshoot the global minimum, oscillate, or diverge","Weights freeze and stop updating","Underfitting is guaranteed to vanish"],a:1,e:"An excessively large learning rate causes step sizes that overshoot cost function valleys, preventing convergence."},
{n:55,t:"Supervised Learning",q:"Logistic Regression uses which activation function to map linear output z into probabilities between 0 and 1?",o:["Step function","Sigmoid (Logistic) function: σ(z) = 1 / (1 + e^-z)","Linear function: f(z) = z","ReLU function: f(z) = max(0, z)"],a:1,e:"The Sigmoid function squashes (-inf, +inf) inputs smoothly into (0, 1) probability bounds."},
{n:57,t:"Supervised Learning",q:"High Variance in a trained machine learning model is a classic symptom of:",o:["Underfitting","Overfitting","Optimal generalization","Insufficient training epochs"],a:1,e:"High variance means the model parameters are overly sensitive to small fluctuations in the training dataset."},
{n:58,t:"Supervised Learning",q:"L1 Regularization (Lasso) differs from L2 Regularization (Ridge) because L1 Regularization:",o:["Adds squared weight penalty sum(w^2)","Adds absolute weight penalty sum(|w|), driving irrelevant feature weights to exactly zero (feature selection)","Increases model capacity","Prevents learning rate decay"],a:1,e:"L1 produces sparse models by zeroing out non-essential feature coefficients, performing implicit feature selection."},
{n:60,t:"Supervised Learning",q:"Decision Trees split internal nodes based on metric criteria such as:",o:["Gini Impurity or Information Gain (Entropy)","Euclidean Distance","Sigmoid activation derivative","Cosine similarity"],a:0,e:"Decision trees choose splits that maximize Information Gain (reduce node impurity/entropy)."},
{n:61,t:"Supervised Learning",q:"Which classification algorithm finds the optimal linear decision boundary hyperplane that maximizes the margin between classes?",o:["K-Nearest Neighbors (KNN)","Naive Bayes","Support Vector Machine (SVM)","Random Forest"],a:2,e:"SVM maximizes the distance (margin) between the decision boundary hyperplane and closest support vector data points."},
{n:63,t:"Unsupervised & Metrics",q:"K-Means Clustering aims to minimize which objective cost function?",o:["Cross-Entropy Loss","Within-Cluster Sum of Squares (WCSS / Inertia)","Mean Absolute Error","Gini Impurity"],a:1,e:"WCSS measures the sum of squared Euclidean distances between data points and their assigned cluster centroid."},
{n:65,t:"Unsupervised & Metrics",q:"The Elbow Method in K-Means clustering is used to select:",o:["The optimal learning rate","The optimal number of clusters K","The feature scaling factor","The maximum tree depth"],a:1,e:"The Elbow Method plots WCSS against K. The point where the rate of WCSS decrease sharply bends ('elbow') indicates the optimal K."},
{n:66,t:"Unsupervised & Metrics",q:"Hierarchical clustering that starts with every data point in its own individual cluster and iteratively merges closest pairs is called:",o:["Agglomerative (Bottom-Up) Clustering","Divisive (Top-Down) Clustering","K-Medoids Clustering","Density-Based Clustering"],a:0,e:"Agglomerative clustering builds a nested hierarchy by iteratively merging smallest-distance clusters."},
{n:68,t:"Unsupervised & Metrics",q:"Principal Component Analysis (PCA) performs unsupervised dimensionality reduction by:",o:["Removing random columns","Projecting data onto orthogonal principal component axes that maximize variance","Converting features into categorical text labels","Computing decision trees"],a:1,e:"PCA identifies orthogonal directions of maximum variance, preserving maximal dataset information in fewer components."},
{n:69,t:"Unsupervised & Metrics",q:"In PCA, principal components correspond mathematically to the eigenvectors of which matrix?",o:["Identity matrix","Confusion matrix","Covariance matrix of standardized feature data","Adjacency matrix"],a:2,e:"Eigenvalues quantify the variance explained by corresponding principal component eigenvectors."},
{n:71,t:"Unsupervised & Metrics",q:"The F1-Score is mathematically defined as:",o:["Arithmetic mean of Precision and Recall","Harmonic mean of Precision and Recall: 2 * (Precision * Recall) / (Precision + Recall)","Product of Accuracy and Sensitivity","Sum of True Positives and True Negatives"],a:1,e:"The harmonic mean penalizes extreme imbalances between Precision and Recall heavily."},
{n:72,t:"Unsupervised & Metrics",q:"In a confusion matrix, a False Positive (FP) error is also classified as a:",o:["Type I Error","Type II Error","True Negative","Standard Error"],a:0,e:"Type I Error (False Positive) occurs when the model incorrectly predicts a positive result for a negative sample. Type II Error is False Negative."},
{n:74,t:"Unsupervised & Metrics",q:"Which density-based clustering algorithm discovers arbitrary shape clusters and automatically flags low-density points as noise outliers?",o:["K-Means","Agglomerative Clustering","DBSCAN","PCA"],a:2,e:"DBSCAN (Density-Based Spatial Clustering of Applications with Noise) relies on eps radius and minPts density parameters."},
{n:75,t:"Neural Networks",q:"In an Artificial Neuron (Perceptron), the weighted linear sum z = sum(w_i * x_i) + b is processed through what function to introduce non-linearity?",o:["Loss Function","Activation Function","Gradient Function","Cost Function"],a:1,e:"Activation functions enable multi-layer neural networks to learn complex non-linear decision boundaries."},
{n:77,t:"Neural Networks",q:"Which activation function suffers from the 'Dying ReLU' problem when input values are negative?",o:["Sigmoid","Tanh","Rectified Linear Unit (ReLU: f(z) = max(0, z))","Softmax"],a:2,e:"For z < 0, ReLU gradient is exactly 0, which can cause neurons to permanently stop updating during training."},
{n:78,t:"Neural Networks",q:"Softmax activation function is used in the output layer of multi-class neural networks because it:",o:["Outputs raw unnormalized numbers","Zeroes out negative weights","Converts unnormalized output logits into a normalized probability distribution that sums to 1.0","Removes bias parameters"],a:2,e:"Softmax(z_i) = exp(z_i) / sum(exp(z_j)), enabling probabilistic interpretation across K classes."},
{n:80,t:"Neural Networks",q:"The Vanishing Gradient problem during backpropagation in deep networks primarily arises when using which activation functions?",o:["Sigmoid and Tanh","ReLU and Leaky ReLU","Linear activations","Step functions"],a:0,e:"Sigmoid/Tanh derivatives saturate near 0 for high magnitude inputs. Multiplying small fractions recursively through many layers causes gradients to vanish."},
{n:81,t:"Neural Networks",q:"In Mini-Batch Gradient Descent, model weights are updated:",o:["After processing every single training sample","After processing a subset batch of m samples","Only once after the entire dataset epoch completes","Continuously every millisecond"],a:1,e:"Mini-batch strikes a balance between computational efficiency of batch GD and noise-robustness of stochastic GD."},
{n:83,t:"Neural Networks",q:"Which optimization technique accelerates SGD by incorporating a fraction of the previous step's update vector to damp oscillations?",o:["L1 Regularization","Momentum","Dropout","Batch Normalization"],a:1,e:"Momentum simulates a heavy ball rolling down a loss landscape, speeding up in consistent directions."},
{n:84,t:"Neural Networks",q:"What does Adam optimizer stand for?",o:["Advanced Data Analysis Method","Adaptive Moment Estimation","Automated Matrix Differentiation","Associated Model Evaluation"],a:1,e:"Adam combines ideas from RMSProp and Momentum by tracking first (mean) and second (uncentered variance) moments of gradients."},
{n:86,t:"Neural Networks",q:"A fully connected Dense layer has 10 inputs and 5 output neurons (with bias). How many total trainable parameters exist?",o:["50","55","60","15"],a:1,e:"Weights = 10 * 5 = 50. Biases = 5. Total parameters = 50 + 5 = 55."},
{n:87,t:"Computer Vision",q:"An 8-bit single-channel grayscale image stores pixel intensity values within which numerical range?",o:["-128 to 127","0 to 255","0 to 1","0 to 65535"],a:1,e:"2^8 = 256 distinct gray levels, where 0 is pure black and 255 is pure white."},
{n:89,t:"Computer Vision",q:"Which OpenCV function converts an image from BGR to Grayscale or HSV color space?",o:["cv2.resize()","cv2.cvtColor()","cv2.threshold()","cv2.Canny()"],a:1,e:"cv2.cvtColor(src, code) handles all color space conversions."},
{n:90,t:"Computer Vision",q:"Otsu's Automatic Thresholding method selects optimal binarization threshold by:",o:["Picking a fixed midpoint of 128","Minimizing intra-class variance between foreground and background pixel populations","Computing average edge length","User manual sliders"],a:1,e:"Otsu's method searches the image histogram to automatically determine the threshold separating bimodal pixel distributions."},
{n:92,t:"Computer Vision",q:"Morphological Erosion operation on a binary image:",o:["Shrinks object boundaries and strips isolated noise dots","Expands object boundaries and fills holes","Blurs image edges","Inverts pixel colors"],a:0,e:"Erosion calculates local minimum under a structuring element, eroding foreground boundaries."},
{n:93,t:"Computer Vision",q:"In OpenCV (`cv2.findContours`), a contour is defined as:",o:["A bounding box rectangle","A continuous curve joining all boundary points having identical intensity/color","A histogram plot","A linear regression line"],a:1,e:"Contours represent object shapes used for area, perimeter, and centroid measurements."},
{n:95,t:"Computer Vision",q:"In the Air Canvas computer vision application, persistent drawing across video camera frames is maintained by:",o:["Redrawing all historical points from scratch on every frame","Maintaining a dedicated numpy binary mask array and ink layer buffer that persist between camera frames","Saving PNG files to disk on every frame","Re-running neural network training"],a:1,e:"Updating persistent mask buffers avoids exponential redraw overhead as stroke length grows."},
{n:97,t:"Advanced AI & Ethics",q:"Algorithmic Bias in AI models primarily stems from:",o:["Fast GPU hardware speeds","Biased, non-representative, or skewed training datasets reflecting historical human prejudices","Using open-source software libraries","High mathematical precision"],a:1,e:"Models learn patterns present in training data; skewed data results in discriminatory predictions."},
{n:99,t:"Advanced AI & Ethics",q:"Which framework is commonly utilized for executing optimized real-time edge AI perception pipelines?",o:["Apache Hadoop","MediaPipe / ONNX Runtime / TensorRT","MySQL Server","HTML5 Engine"],a:1,e:"Edge frameworks optimize model graphs and hardware acceleration for real-time inference on edge devices."},
